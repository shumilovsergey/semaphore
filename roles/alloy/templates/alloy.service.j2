[Unit]
Description=Grafana Alloy
After=network.target

[Service]
Type=simple
User={{ service_user }}

WorkingDirectory={{ alloy_path }}
ExecStart={{ bin_path }} run \
  --server.http.listen-addr={{ alloy_http_addr }}:{{ alloy_port }} \
  --storage.path={{ data_path }} \
  {{ config_path }}

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
