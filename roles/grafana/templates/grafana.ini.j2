; {{ ansible_managed }} — роль grafana, правки руками затрутся
; Полный список опций — в {{ grafana_path }}/conf/defaults.ini,
; здесь только то, что роль реально задаёт.

[paths]
data = {{ data_path }}
logs = {{ logs_path }}
plugins = {{ plugins_path }}
provisioning = {{ provisioning_path }}

[server]
protocol = http
http_addr = {{ grafana_http_addr }}
http_port = {{ grafana_port }}
{% if grafana_root_url | default('') | length > 0 %}
root_url = {{ grafana_root_url }}
{% endif %}

[database]
type = {{ grafana_db_type }}
; путь без слеша — относительно [paths] data
path = {{ grafana_db_name }}

[security]
; применяется только при создании базы, дальше пароль в sqlite
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}

[users]
allow_sign_up = {{ grafana_allow_sign_up | bool | lower }}

[auth.anonymous]
enabled = {{ grafana_anonymous_enabled | bool | lower }}

[analytics]
reporting_enabled = false
check_for_updates = false

[log]
mode = console file
level = info
