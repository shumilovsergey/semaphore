[Unit]
Description=Grafana
After=network.target

[Service]
Type=simple
User={{ service_user }}

WorkingDirectory={{ grafana_path }}
ExecStart={{ bin_path }} server \
  --homepath={{ grafana_path }} \
  --config={{ config_path }}

Restart=on-failure
RestartSec=5
LimitNOFILE=10000

[Install]
WantedBy=multi-user.target
