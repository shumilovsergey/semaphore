[Unit]
Description={{ app_name }}
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory={{ app_path }}

{# APP_NAME берётся из app_name плейбука; явное значение в env перекроет его — systemd берёт последнее #}
Environment=APP_NAME={{ app_name }}
{% for key, value in app_config.env.items() %}
Environment={{ key }}={{ value }}
{% endfor %}

ExecStart={{ app_path }}/{{ app_name }}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target